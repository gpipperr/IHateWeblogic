# =============================================================================
# nginx-wls.conf.template – Nginx reverse proxy for Oracle Forms & Reports
# =============================================================================
# Managed by : 09-Install/04-root_nginx.sh
# Template   : Variables are replaced by the script using ##VARIABLE## syntax
#
# Reference  : https://www.pipperr.de/dokuwiki/doku.php?id=prog:oracle_apex_nginx_tomcat_ords_install_windows_server
#              https://www.pipperr.de/dokuwiki/doku.php?id=prog:gitlab_oracle_linux_9
#
# Variables replaced at install time:
#   ##SERVER_NAME##        FQDN of this server (e.g. wls01.company.local)
#   ##WLS_FORMS_PORT##     WLS_FORMS listen port  (default: 9001)
#   ##WLS_REPORTS_PORT##   WLS_REPORTS listen port (default: 9002)
#   ##WLS_ADMIN_PORT##     AdminServer listen port  (default: 7001)
#   ##SSL_CERT##           Path to SSL fullchain certificate PEM file
#   ##SSL_KEY##            Path to SSL private key PEM file
#   ##ADMIN_IP_RANGE##     Network allowed to reach /console (e.g. 10.0.0.0/8)
#   FORMS_CLIENT_URL_PATH / FORMS_CLIENT_DIR  Forms client bundle – the marked block
#                          below "Forms client bundle" is kept only with
#                          FORMS_CLIENT_DIST=true (docs/40-forms_client_distribution.md)
#
# Deployment: place in /etc/nginx/conf.d/oracle-wls.conf
# Note: no http{} block – conf.d files are included inside the http{} block
#       of /etc/nginx/nginx.conf (standard OL9 Nginx package layout)
# =============================================================================

# ---------------------------------------------------------------------------
# Upstream targets – WebLogic listens on 127.0.0.1 only (Nginx is the gateway)
# ---------------------------------------------------------------------------

upstream wls_forms {
    server 127.0.0.1:##WLS_FORMS_PORT##;
    keepalive 32;
}

upstream wls_reports {
    server 127.0.0.1:##WLS_REPORTS_PORT##;
    keepalive 32;
}

upstream wls_admin {
    server 127.0.0.1:##WLS_ADMIN_PORT##;
    keepalive 16;
}

# ---------------------------------------------------------------------------
# HTTP → HTTPS redirect (all plain HTTP requests)
# ---------------------------------------------------------------------------

server {
    listen 80;
    listen [::]:80;
    server_name ##SERVER_NAME## _;
    return 301 https://$host$request_uri;
}

# ---------------------------------------------------------------------------
# HTTPS – SSL termination + reverse proxy to WebLogic
# ---------------------------------------------------------------------------

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ##SERVER_NAME##;

    # --- SSL Certificate --------------------------------------------------
    ssl_certificate     ##SSL_CERT##;
    ssl_certificate_key ##SSL_KEY##;

    # --- TLS protocol & ciphers (TLS 1.2 + 1.3 only) ---------------------
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256';
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    # --- HSTS (enable after verifying SSL works – prevents downgrade) -----
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # --- Compression ------------------------------------------------------
    gzip on;
    gzip_types text/plain text/css application/javascript application/json
               application/xml text/xml image/svg+xml;

    # --- Common proxy headers (sent to all WebLogic upstreams) -----------
    # Inherited by a location ONLY if that location sets no proxy_set_header
    # of its own – never add a single proxy_set_header to a WebLogic location
    # (it would drop Host, WL-Proxy-* and the stripping below; /console had
    # that bug until 2026-10-26).
    proxy_http_version      1.1;               # HTTP/1.1 for keep-alive + chunked
    proxy_set_header        Host               $host;
    proxy_set_header        X-Real-IP          $remote_addr;
    # Overwrite, not append: Nginx faces the clients directly – a client-supplied
    # chain ($proxy_add_x_forwarded_for) could fake the client IP in WLS logs
    proxy_set_header        X-Forwarded-For    $remote_addr;
    proxy_set_header        X-Forwarded-Proto  https;
    proxy_set_header        Connection         "";  # clear Connection header for keep-alive
    proxy_connect_timeout   60s;
    proxy_read_timeout      120s;
    proxy_send_timeout      120s;
    client_max_body_size    100m;              # for Forms file upload / Reports output

    # --- WebLogic-specific headers ----------------------------------------
    proxy_set_header        WL-Proxy-Client-IP $remote_addr;
    proxy_set_header        WL-Proxy-SSL       true;

    # --- Strip client-supplied WebLogic proxy / control headers -----------
    # Nginx counterpart of the OHS / mod_wl hardening of the CPU Oct 2026
    # (MOS KB559857: WLStripWLProxyHeaders, WLStripPathRewriteHeaders,
    # WLStripWebLogicControlHeaders, WLStripTyrusConnectionHeader). With
    # weblogic-plugin-enabled=true WebLogic trusts these headers; only a proxy
    # may set them. "" = header is not passed. X-WebLogic-* has no wildcard in
    # Nginx – the known names of the plug-in protocol are listed.
    # Live-tested 2026-10-26 (tcpdump on the loopback).
    proxy_set_header        WL-Proxy-Client-Cert          "";
    proxy_set_header        WL-Proxy-Client-Keysize       "";
    proxy_set_header        WL-Proxy-Client-Secretkeysize "";
    proxy_set_header        WL-Proxy-Client-Port          "";
    proxy_set_header        WL-PATH-TRIM                  "";
    proxy_set_header        WL-PATH-PREPEND               "";
    proxy_set_header        X-WebLogic-KeepAliveSecs      "";
    proxy_set_header        X-WebLogic-Force-JVMID        "";
    proxy_set_header        X-WebLogic-JVMID              "";
    proxy_set_header        X-WebLogic-Request-ClusterInfo "";
    proxy_set_header        X-WebLogic-Cluster-List       "";
    proxy_set_header        X-WebLogic-Cluster-Hash       "";
    proxy_set_header        tyrus-connection-id           "";

    # --- Oracle Forms (/forms) --------------------------------------------
    location /forms/ {
        proxy_pass http://wls_forms;
        proxy_cookie_path /forms /forms;       # preserve cookie path for session tracking
    }

    location /forms {
        return 301 /forms/;
    }

    #@FORMS_CLIENT_BEGIN@
    # --- Forms client bundle (static, read-only) -----------------------------
    location ##FORMS_CLIENT_URL_PATH##/ {
        alias ##FORMS_CLIENT_DIR##/;
        autoindex off;
        types { application/json json; application/zip zip;
                application/java-archive jar; text/plain ps1; }
        default_type application/octet-stream;        # dll, cmd (browser downloads the bootstrap)
    }

    location = ##FORMS_CLIENT_URL_PATH##/manifest.json {
        alias ##FORMS_CLIENT_DIR##/manifest.json;
        default_type application/json;
        add_header Cache-Control "no-cache" always;   # revalidate, ETag -> 304
    }

    location = ##FORMS_CLIENT_URL_PATH## {
        return 301 ##FORMS_CLIENT_URL_PATH##/;
    }
    #@FORMS_CLIENT_END@

    # --- Oracle Reports (/reports) ----------------------------------------
    # --- Reports admin web commands: localhost + admin network only -------
    # getserverinfo / showjobs / showenv / showmap show server, job and
    # environment details, killjobid / stopserver change state; status checks
    # of the scripts call 127.0.0.1:<WLS_REPORTS_PORT> directly. Users keep
    # getjobid / showjobid / showmyjobs (fetch their own results).
    # (09-Install/docs/81-reports_rwservlet_security.md, 2026-10-23)
    location ~* ^/reports/rwservlet/(getserverinfo|showjobs|showenv|showmap|showauth|delauth|killjobid|parsequery|stopserver) {
        allow 127.0.0.1;
        allow ##ADMIN_IP_RANGE##;
        deny  all;
        proxy_pass http://wls_reports;
        proxy_cookie_path /reports /reports;
    }

    location /reports/ {
        proxy_pass http://wls_reports;
        proxy_cookie_path /reports /reports;

        # Reports job downloads can be large and slow
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location /reports {
        return 301 /reports/;
    }

    # --- WebLogic Admin Console (/console) --------------------------------
    # Access restricted to admin network – adjust ##ADMIN_IP_RANGE## accordingly
    location /console {
        allow ##ADMIN_IP_RANGE##;
        deny  all;
        proxy_pass http://wls_admin;
        # no proxy_set_header here – it would drop the inherited headers
    }

    # --- WebLogic Enterprise Manager (/em) --------------------------------
    location /em {
        allow ##ADMIN_IP_RANGE##;
        deny  all;
        proxy_pass http://wls_admin;
    }

    # --- Further applications in this server block (one file each) ---------
    # e.g. APEX / ORDS: /etc/nginx/oracle-wls.d/ords_1.conf, written by
    # 12-APEX-Ords/05-setup-nginx.sh – remove an application = delete its file.
    # Not below conf.d/: those files are loaded at http{} level.
    include /etc/nginx/oracle-wls.d/*.conf;

    # --- Health check endpoint (Nginx itself, no proxy) -------------------
    location /nginx-health {
        access_log off;
        return 200 "OK\n";
        add_header Content-Type text/plain;
    }

    # --- Deny hidden files ------------------------------------------------
    location ~ /\. {
        deny all;
        access_log off;
    }
}
