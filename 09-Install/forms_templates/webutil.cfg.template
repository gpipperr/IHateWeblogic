# =============================================================================
# webutil.cfg – Oracle Forms WebUtil File Transfer Configuration
# Target : $FR_INST/server/webutil.cfg
#          $FR_INST_ALT/server/webutil.cfg  (both locations kept in sync)
# Managed: 09-Install/14-oracle_setup_forms.sh --apply
# =============================================================================
#
# OVERRIDES ONLY: 14- starts from Oracle's own webutil.cfg
# ($ORACLE_HOME/forms/templates/config/webutil.cfg – keeps install.syslib.*,
# logging.*) and replaces the keys set here; comments here are not copied.
#
# CUSTOMER SETUP:
#   transfer.appsrv.read.N  – directories the server is allowed to read from
#   transfer.appsrv.write.N – directories the server is allowed to write to
#   transfer.appsrv.workAreaRoot – temp area for file operations (FORMS_TMP)
#
# The numbered entries (read.1, read.2 …) are evaluated in order.
# Add as many as needed; remove unused entries.
# =============================================================================

# ── File Transfer ─────────────────────────────────────────────────────────────
# NOTE: file transfer is disabled by default as a security measure.
# Set to TRUE only for environments where WebUtil file transfer is required.
transfer.database.enabled=TRUE
transfer.appsrv.enabled=TRUE
transfer.appsrv.workAreaRoot=##FORMS_TMP##
transfer.appsrv.accessControl=TRUE

# ── Read / Write Directories ─────────────────────────────────────────────────
# Default: one transfer directory below FORMS_TMP – 14- creates it. The same
# directory the customer import maps old transfer directories to (rule
# WEBUTIL_DIRS). Until 2026-11-05 the example paths /mnt/shared/import and
# /mnt/shared/export were active here – on a host without that share they
# are directories that do not exist (found by the analysis of a customer host).
# ADAPT: add the directories your Forms application reads from / writes to
# (shares must be mounted – 14- creates only directories below FORMS_TMP).
transfer.appsrv.read.1=##FORMS_TMP##/webutil
transfer.appsrv.write.1=##FORMS_TMP##/webutil
# transfer.appsrv.read.2=/mnt/shared/import
# transfer.appsrv.read.3=/mnt/shared/export
# transfer.appsrv.write.2=/mnt/shared/import
