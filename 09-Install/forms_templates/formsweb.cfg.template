# =============================================================================
# formsweb.cfg – Oracle Forms Web Configuration
# Target : $DOMAIN_HOME/config/fmwconfig/servers/$WLS_FORMS_SERVER/
#          applications/formsapp_<version>/config/formsweb.cfg
# Managed: 09-Install/14-oracle_setup_forms.sh --apply
# =============================================================================
#
# OVERRIDES ONLY for [default]: 14- starts from Oracle's own formsweb.cfg
# ($ORACLE_HOME/forms/templates/config/formsweb.cfg – keeps serverArgs,
# otherparams, the 14.1.2 launcher settings and the sections [webstart],
# [standaloneapp], [webutil_*], [jnlp] ...). Keys set here replace Oracle's
# value in [default], missing keys are added to [default]; comments here are
# not copied. Before 2026-10-16 this file REPLACED Oracle's file (12c content:
# no [webstart]/[standaloneapp], no serverArgs, frmopt.jar, java_version=1.7+).
#
# CUSTOMER SETUP – optional keys for [default]:
#   form=           – default start form (.fmx without path; Oracle: test.fmx)
#   pageTitle=      – application name shown in browser tab and title bar
#   background= / logo= – branding GIFs
#   customColorScheme= – colour scheme defined in Registry.dat
# Application sections ([myapp], called with config=myapp): add them in the
# deployed file or via EM – this overlay only touches [default].
# =============================================================================

# ── Window / client behaviour ────────────────────────────────────────────────
width=1030
height=860
separateFrame=true
splashScreen=no
CenterOnStartup=true

# ── Pre-started runtimes ─────────────────────────────────────────────────────
# NOT here: Oracle advises against prestartRuntimes in [default] (every section
# inherits it – 10 sections x prestartInit processes). 14- sets the prestart
# keys only in FORMS_PRESTART_SECTION (environment.conf, empty = no pooling).

# ── WebUtil ──────────────────────────────────────────────────────────────────
# WebUtilArchive: set by 14- (frmwebutil.jar, + jacob.jar only when signed)
WebUtilArchive=##WEBUTIL_ARCHIVE##
WebUtilLogging=off
WebUtilLoggingDetail=normal
WebUtilErrorMode=Alert
WebUtilDispatchMonitorInterval=5
WebUtilTrustInternal=true
WebUtilMaxTransferSize=24573
