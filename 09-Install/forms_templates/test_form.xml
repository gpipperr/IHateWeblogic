<?xml version="1.0" encoding="UTF-8"?>
<!--
  IHateWeblogic - Minimal Forms Test Module (smoke test)

  Purpose: verify that a Forms installation can compile a form that touches
  the database, without Forms Builder. No customer data, no business logic -
  just SYSDATE and a row count from USER_OBJECTS.

  STATUS: VERIFIED 2026-10-16 against Forms 14.1.2 (XML2Forms -> FMB,
  frmcmp_batch -> FMX, trigger compiled against the DB). Attribute names and
  values follow the schema generated by frmxmlsg.sh (forms.xsd) and a
  Forms2XML roundtrip of $ORACLE_HOME/forms/test.fmb:
    - Module version is a number: 141020000 (= 14.1.2), not "12.2.1.4.0"
    - booleans are true/false (DatabaseBlock="false"), not Yes/No
    - Item: Prompt, MaximumLength (not PromptText / MaxLength)
    - Coordinate: CoordinateSystem="Real" RealUnit="Point"
    - line breaks in TriggerText are written as &amp;#10; (like Forms2XML)
  See 09-Install/docs/20-forms_reports_testmodules.md (Part 1 - Forms).

  Deployed/compiled by: 09-Install/15-deploy-test-report-forms_template.sh
-->
<Module version="141020000" xmlns="http://xmlns.oracle.com/Forms">
  <FormModule Name="TEST_FORM" ConsoleWindow="WIN_MAIN" Title="IHateWeblogic Test Form">
    <Coordinate CoordinateSystem="Real" RealUnit="Point" CharacterCellWidth="5" CharacterCellHeight="14"/>
    <Block Name="BL_DATA" DatabaseBlock="false">
      <Item Name="IT_SYSDATE" ItemType="Text Item" CanvasName="CV_MAIN" DatabaseItem="false"
            Prompt="Server Date/Time" DataType="Char" MaximumLength="40"
            XPosition="150" YPosition="30" Width="160" Height="18"/>
      <Item Name="IT_OBJ_COUNT" ItemType="Text Item" CanvasName="CV_MAIN" DatabaseItem="false"
            Prompt="USER_OBJECTS Row Count" DataType="Char" MaximumLength="20"
            XPosition="150" YPosition="60" Width="80" Height="18"/>
    </Block>
    <Canvas Name="CV_MAIN" WindowName="WIN_MAIN" CanvasType="Content" Width="400" Height="120"/>
    <Window Name="WIN_MAIN" Title="IHateWeblogic Test Form" PrimaryCanvas="CV_MAIN" Width="400" Height="120"/>
    <Trigger Name="WHEN-NEW-FORM-INSTANCE" TriggerText="BEGIN&amp;#10;  :BL_DATA.IT_SYSDATE := TO_CHAR(SYSDATE, 'YYYY-MM-DD HH24:MI:SS');&amp;#10;  SELECT TO_CHAR(COUNT(*)) INTO :BL_DATA.IT_OBJ_COUNT FROM USER_OBJECTS;&amp;#10;END;"/>
  </FormModule>
</Module>
