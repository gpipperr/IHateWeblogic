<?xml version="1.0" encoding="UTF-8"?>
<!--
  IHateWeblogic – Minimal Forms Test Module (smoke test)

  Purpose: verify that a Forms installation can compile and run a form that
  touches the database, without needing Forms Builder. No customer data,
  no business logic — just SYSDATE and a row count from USER_OBJECTS.

  STATUS: UNVERIFIED. This XML source has not yet been compiled against a
  real Forms 14.1.2 installation. See:
    09-Install/docs/20-forms_reports_testmodules.md (Part 1 – Forms)
  In particular, the Module "version" attribute below and several
  Window/Canvas/Item attribute names are best-effort guesses based on
  Oracle's Forms2XML documentation, not a verified dump from this Forms
  version. If frmxml2f rejects this file:
    1. Check the reported line/attribute against the XSD generated by
       frmxmlsg (ships next to frmf2xml in $ORACLE_HOME/forms/bin).
    2. If that doesn't resolve it, fall back to the JDAPI approach
       documented in the same section (Plan B).

  Deployed/compiled by: 09-Install/15-deploy-test-report-forms_template.sh
-->
<Module version="12.2.1.4.0" xmlns="http://xmlns.oracle.com/Forms">
  <FormModule Name="TEST_FORM" ConsoleWindow="WIN_MAIN" Title="IHateWeblogic Test Form">

    <Coordinate SnapToGrid="Yes" CoordinateSystem="Char" CharUnit="12,24"/>

    <Window Name="WIN_MAIN" Title="IHateWeblogic Test Form"
            PrimaryCanvas="CV_MAIN" ShowScrollBar="Yes"
            ViewportXPosition="0" ViewportYPosition="0"
            ViewportWidth="80" ViewportHeight="10"/>

    <Canvas Name="CV_MAIN" WindowName="WIN_MAIN" CanvasType="Content"
            ViewportWidth="80" ViewportHeight="10"/>

    <Block Name="BL_DATA" DatabaseBlock="No">
      <Item Name="IT_SYSDATE" ItemType="Text Item" CanvasName="CV_MAIN"
            PromptText="Server Date/Time" DataType="Char" MaxLength="40"
            XPosition="2" YPosition="2" Width="40" Height="1"/>
      <Item Name="IT_OBJ_COUNT" ItemType="Text Item" CanvasName="CV_MAIN"
            PromptText="USER_OBJECTS Row Count" DataType="Char" MaxLength="20"
            XPosition="2" YPosition="4" Width="20" Height="1"/>
    </Block>

    <Trigger Name="WHEN-NEW-FORM-INSTANCE" TriggerText="BEGIN&#10;  :BL_DATA.IT_SYSDATE := TO_CHAR(SYSDATE, 'YYYY-MM-DD HH24:MI:SS');&#10;  SELECT TO_CHAR(COUNT(*)) INTO :BL_DATA.IT_OBJ_COUNT FROM USER_OBJECTS;&#10;END;"/>

  </FormModule>
</Module>
