# =============================================================================
# default.env – Oracle Forms Runtime Environment
# Target : $DOMAIN_HOME/config/fmwconfig/servers/$WLS_FORMS_SERVER/
#          applications/formsapp_<version>/config/default.env
# Managed: 09-Install/14-oracle_setup_forms.sh --apply
# =============================================================================
#
# Paths are ##...## placeholders filled from environment.conf by
# 14-oracle_setup_forms.sh (ORACLE_HOME, DOMAIN_HOME, JDK_HOME,
# FORMS_INSTANCE_NAME, REPORTS_TOOLS_INSTANCE, FORMS_CUSTOMER_DIR,
# TNS_ADMIN - environment.conf, one directory for all processes, check:
# 02-Checks/tns_admin_check.sh; unset = $DOMAIN_HOME/config/fmwconfig). Before 2026-10-15 they
# were hard-coded for another host layout (/u01/oracle/fmw, /u01/user_projects).
#
# CUSTOMER SETUP – adapt only the non-path values before running the script:
#   FORMS_PATH           – add further .fmb/.fmx directories if needed
#   NLS_LANG             – Oracle NLS language (must match DB character set)
#   NLS_DATE_FORMAT      – date display format
# =============================================================================

[default]
baseHTML=base.htm

# ── Oracle Homes ─────────────────────────────────────────────────────────────
ORACLE_HOME=##ORACLE_HOME##
FORMS_INSTANCE=##DOMAIN_HOME##/config/fmwconfig/components/FORMS/instances/##FORMS_INSTANCE_NAME##

# ── Oracle Net ───────────────────────────────────────────────────────────────
TNS_ADMIN=##TNS_ADMIN##

# ── Forms Search Paths ───────────────────────────────────────────────────────
# Colon-separated list: application source dir first, then FMW defaults
FORMS_PATH=##FORMS_CUSTOMER_DIR##:##ORACLE_HOME##/forms:##DOMAIN_HOME##/config/fmwconfig/components/FORMS/instances/##FORMS_INSTANCE_NAME##
FORMS_MODULE_PATH=$FORMS_PATH

# ── WebUtil ──────────────────────────────────────────────────────────────────
WEBUTIL_CONFIG=##DOMAIN_HOME##/config/fmwconfig/components/FORMS/instances/##FORMS_INSTANCE_NAME##/server/webutil.cfg

# ── NLS / Locale ─────────────────────────────────────────────────────────────
# NLS_LANG must match the Oracle DB character set
# Common values:
#   GERMAN_GERMANY.UTF8         (UTF-8 client, recommended for FMW 14c)
#   GERMAN_GERMANY.WE8ISO8859P15 (ISO-8859-15, legacy)
#   AMERICAN_AMERICA.AL32UTF8
NLS_LANG=GERMAN_GERMANY.UTF8
NLS_DATE_FORMAT=DD.MM.YYYY
NLS_LENGTH_SEMANTICS=CHAR
FORMS_DATETIME_LOCAL_TZ=GMT
FORMS_DATETIME_SERVER_TZ=GMT

# ── Forms Runtime Settings ───────────────────────────────────────────────────
FORMS_RESTRICT_ENTER_QUERY=FALSE
FORMS_LIMIT_EXTERNAL_MESSAGES=1

# ── Reports Tools Integration ─────────────────────────────────────────────────
# COMPONENT_CONFIG_PATH: path to ReportsToolsComponent instance directory
# Used when Forms calls Reports on the same host
COMPONENT_CONFIG_PATH=##DOMAIN_HOME##/config/fmwconfig/components/ReportsToolsComponent/##REPORTS_TOOLS_INSTANCE##

# ── Temp Directory ───────────────────────────────────────────────────────────
TMPDIR=##FORMS_TMP##

# ── CLASSPATH (Forms Debugger + Password Expiry) ─────────────────────────────
# Adjust ORACLE_HOME if it differs from the path above
# CLASSPATH / LD_LIBRARY_PATH on ONE line each, entries as in Oracle's
# 14.1.2 default.env (jakarta.* modules, jps-manifest.jar, ldapjclnt.jar).
# The previous list (12c names: ldapjclnt11.jar, jpsmanifest.jar,
# javax.management.j2ee.jar, frmopt.jar) pointed to files that no longer
# exist in 14.1.2, and default.env has no documented line continuation
# (corrected 2026-10-15).
CLASSPATH=##ORACLE_HOME##/jlib/frmbipc.jar:##ORACLE_HOME##/forms/j2ee/frmsrv.jar:##ORACLE_HOME##/forms/provision/frmconfig.jar:##ORACLE_HOME##/jlib/ldapjclnt.jar:##ORACLE_HOME##/jlib/debugger.jar:##ORACLE_HOME##/oracle_common/jlib/ewt3.jar:##ORACLE_HOME##/oracle_common/modules/oracle.bali.share/share.jar:##ORACLE_HOME##/jlib/utj.jar:##ORACLE_HOME##/jlib/zrclient.jar:##ORACLE_HOME##/reports/jlib/rwrun.jar:##ORACLE_HOME##/forms/java/frmwebutil.jar:##ORACLE_HOME##/oracle_common/modules/oracle.jps/jps-manifest.jar:##ORACLE_HOME##/oracle_common/modules/oracle.dms/dms.jar:##ORACLE_HOME##/oracle_common/modules/oracle.odl/ojdl.jar:##ORACLE_HOME##/oracle_common/modules/jakarta.management.j2ee.jakarta.management.j2ee-api.jar:##ORACLE_HOME##/oracle_common/modules/jakarta.xml.bind.jakarta.xml.bind-api.jar:##ORACLE_HOME##/oracle_common/modules/com.sun.xml.bind.jaxb-impl.jar:##ORACLE_HOME##/oracle_common/modules/com.sun.activation.jakarta.activation.jar

# ── PATH ─────────────────────────────────────────────────────────────────────
# Must include ORACLE_HOME/bin and JDK/bin
# Adjust JDK path to match your installation (set via 02b-root_os_java.sh)
PATH=##ORACLE_HOME##/bin:##JDK_HOME##/bin

# ── Shared Libraries ─────────────────────────────────────────────────────────
LD_LIBRARY_PATH=##ORACLE_HOME##/lib:##JDK_HOME##/lib:##JDK_HOME##/lib/server

# ── Signal-Chaining (Forms/Reports integration) ──────────────────────────────
# libjsig.so prevents signal conflicts between the JVM and Oracle native libs
LD_PRELOAD=##JDK_HOME##/lib/libjsig.so
