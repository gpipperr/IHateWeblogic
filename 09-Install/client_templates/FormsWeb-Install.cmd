@echo off
rem ============================================================================
rem FormsWeb-Install.cmd - bootstrap of the Forms client (user scope, no admin)
rem Downloads FormsWeb-Setup.ps1 from the Forms server into
rem %LOCALAPPDATA%\FormsWeb, checks its SHA-256 against manifest.json and runs
rem it with -Install. A .cmd is not subject to the PowerShell ExecutionPolicy.
rem Generated by 09-Install/40-oracle_forms_client_bundle.sh (@@BASE_URL@@ set).
rem Concept: 09-Install/docs/40-forms_client_distribution.md
rem ============================================================================
setlocal
set "FW_BASE=@@BASE_URL@@"
set "FW_DIR=%LOCALAPPDATA%\FormsWeb"
if not exist "%FW_DIR%" mkdir "%FW_DIR%"
echo Installing the Oracle Forms client from %FW_BASE% ...
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $ProgressPreference='SilentlyContinue'; [Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12; $b='%FW_BASE%'; $d='%FW_DIR%'; $m=Invoke-RestMethod -UseBasicParsing -UseDefaultCredentials -Uri ($b+'manifest.json'); $p=Join-Path $d 'FormsWeb-Setup.ps1'; Invoke-WebRequest -UseBasicParsing -UseDefaultCredentials -Uri ($b+$m.setup.file) -OutFile $p; if ((Get-FileHash $p -Algorithm SHA256).Hash -ne $m.setup.sha256) { Remove-Item $p; throw 'SHA-256 of FormsWeb-Setup.ps1 does not match manifest.json' }; & $p -Install -BaseUrl $b"
if errorlevel 1 (
  echo.
  echo Installation failed - see %FW_DIR%\logs
  pause
  exit /b 1
)
endlocal
