# ENV_TYPE=FMW
# ENV_LABEL=Production – Forms & Reports Domain
# =============================================================================
# environment.conf – FMW / WebLogic Domain
# Generated by: 09-Install/01-setup-interview.sh --apply
# Template:     rename to fmw_prod.conf and adapt paths
# =============================================================================

ORACLE_HOME=/u01/oracle/fmw
DOMAIN_HOME=/u01/user_projects/domains/fr_domain
JDK_HOME=/u01/app/oracle/java/jdk-21

ORACLE_BASE=/u01/app/oracle

WLS_SERVER_FQDN=wls01.company.local
WLS_LISTEN_ADDRESS=127.0.0.1
WLS_ADMIN_PORT=7001
WLS_FORMS_PORT=8001
WLS_REPORTS_PORT=9001
WLS_NODEMANAGER_PORT=5556
WLS_MANAGED_SERVER=WLS_REPORTS

# --- Forms Components --------------------------------------------------------
# FORMS_INSTANCE_NAME: name of the Forms system component instance
FORMS_INSTANCE_NAME=forms1
# WLS_FORMS_SERVER: WLS managed server running Oracle Forms
WLS_FORMS_SERVER=WLS_FORMS
# Forms directories - default layout $ORACLE_BASE/forms/{moduls,tmp}
# (outside ORACLE_HOME and /tmp; created by 09-Install/14-oracle_setup_forms.sh)
# TNS_ADMIN: ONE Oracle Net directory (tnsnames.ora, sqlnet.ora) for Forms default.env,
# Reports rwserver.conf/reports.sh, setUserOverrides.sh, oracle .bash_profile
# (check: 02-Checks/tns_admin_check.sh)
TNS_ADMIN=/u01/app/oracle/admin/tns_names
# FORMS_CUSTOMER_DIR: Forms modules (.fmx/.fmb), first entry of FORMS_PATH
FORMS_CUSTOMER_DIR=/u01/app/oracle/forms/moduls
# FORMS_TMP: TMPDIR of the Forms runtime (default.env)
FORMS_TMP=/u01/app/oracle/forms/tmp
# FORMS_PRESTART_SECTION: formsweb.cfg section with runtime pooling (prestart
# frmweb processes), e.g. webstart / standaloneapp / own app section.
# Empty = no pooling. Never [default] – Oracle: all sections would inherit it.
FORMS_PRESTART_SECTION=
FORMS_PRESTART_INIT=5
FORMS_PRESTART_MIN=4
FORMS_PRESTART_INCREMENT=1
# Forms session limit, formsweb.cfg [default] maxRuntimeProcesses (14-); 0 = no
# limit = DoS risk (Oracle). Proposal: half of the RAM / 64 MB per session
FORMS_MAX_RUNTIME_PROCESSES=
# FORMS_WEBUTIL_JACOB: install JACOB (Java COM bridge) for WebUtil OLE /
# Office automation (CLIENT_OLE2). Only needed if the Forms applications
# drive Word/Excel; downloaded by 04-, installed by 14- (default: false)
FORMS_WEBUTIL_JACOB=false
# Code signing of jacob.jar by 14- (empty keystore = do not sign, only check).
# FORMS_SIGN_KEYSTORE: PKCS12 with key + code-signing certificate + chain,
#   e.g. created by 08-SSL/ssl_local_ca.sh codesign --apply; password in
#   forms_sign_sec.conf.des3 (FORMS_SIGN_STOREPASS)
# FORMS_SIGN_TSA_URL: timestamp authority for jarsigner -tsa (empty = none)
FORMS_SIGN_KEYSTORE=
FORMS_SIGN_ALIAS=forms_codesign
FORMS_SIGN_TSA_URL=
# FORMS_SIGN_LOCALCA: true = 14- creates a missing keystore with the own root CA
FORMS_SIGN_LOCALCA=false
# FORMS_CLIENT_*: Forms client distribution via URL (concept
# 09-Install/docs/40-forms_client_distribution.md) – Forms installs only.
# true = 03- creates FORMS_CLIENT_DIR, Nginx serves it under FORMS_CLIENT_URL_PATH
FORMS_CLIENT_DIST=false
FORMS_CLIENT_DIR=/srv/formsWeb
FORMS_CLIENT_URL_PATH=/formsWeb
FORMS_CLIENT_BASE_URL=https://wls01.company.local
FORMS_CLIENT_CONFIG=standaloneapp
FORMS_CLIENT_FORM=
FORMS_CLIENT_APP_NAME="Oracle Forms"
# shortcut icon: .ico, or .png <= 256 px (40- wraps it into an ICO); local path or
# http(s) URL (04- downloads it to $PATCH_STORAGE/icon/); empty = Windows default;
# default IHateWeblogic.ico is copied by 04- from 09-Install/forms_templates/
FORMS_CLIENT_ICON=/srv/patch_storage/icon/IHateWeblogic.ico
# jlink = slim runtime, jdk = full JDK ZIP
FORMS_CLIENT_RUNTIME=jlink
# CA for the bundled runtime's truststore; empty = public CA
FORMS_CLIENT_TRUST_CA=

# --- OS hardening (09-Install/01-root_os_baseline.sh, sections 8 + 9) --------
# SSH_ALLOW_USERS: sshd AllowUsers (empty = check only, no sshd change).
#   At customers with AD/LDAP logins: use own admin users or AllowGroups by hand.
# SSH_PASSWORD_USERS: users keeping password login (emergency access) –
#   all other allowed users need ~/.ssh/authorized_keys (key only).
SSH_ALLOW_USERS=
SSH_PASSWORD_USERS=
# FIREWALL_REMOVE_SERVICES: firewalld services offered for removal (default cockpit)
# FIREWALL_ROLLBACK_MIN: safety-net timer when enabling firewalld / sshd hardening
FIREWALL_REMOVE_SERVICES=cockpit
FIREWALL_ROLLBACK_MIN=10

DB_HOST=dbserver01
DB_PORT=1521
DB_SERVICE=FRPRD
DB_SCHEMA_PREFIX=DEV
# RCU database type (09-Install/07-oracle_setup_repository.sh -databaseType):
#   EBR    Oracle Database enabled for edition-based redefinition (default)
#   ORACLE Oracle Database without editions
RCU_DB_TYPE=EBR

CGICMD_DAT=${DOMAIN_HOME}/config/fmwconfig/servers/${WLS_MANAGED_SERVER}/applications/reports_14.1.2/configuration/cgicmd.dat
RWSERVER_CONF=${DOMAIN_HOME}/config/fmwconfig/components/ReportsServerComponent/repserver01/rwserver.conf
UIFONT_ALI=${DOMAIN_HOME}/config/fmwconfig/components/ReportsToolsComponent/reptools1/uifont.ali
REPORTS_FONT_DIR=${DOMAIN_HOME}/reports/fonts

# --- Reports Instance Names --------------------------------------------------
# REPORTS_TOOLS_INSTANCE: always exactly one per domain
REPORTS_TOOLS_INSTANCE=reptools_ent
# REPORTS_SERVER_INSTANCES: space-separated; multiple allowed
REPORTS_SERVER_INSTANCES=repserver_ent

# --- Reports Runtime Configuration -------------------------------------------
# Report directories - default layout $ORACLE_BASE/reports/{source,images,tmp}
# (outside ORACLE_HOME and /tmp; created by 09-Install/13-oracle_setup_reports.sh)
REPORTS_CUSTOMER_DIR=/u01/app/oracle/reports/source
REPORTS_IMAGE_DIR=/u01/app/oracle/reports/images
# REPORTS_PATH: sources + images, ':'-separated (rwserver.conf <folderAccess><read> gets ';')
REPORTS_PATH=/u01/app/oracle/reports/source:/u01/app/oracle/reports/images
# Writable directory for output files (must be accessible by Reports engines)
REPORTS_TMP=/u01/app/oracle/reports/tmp
# Reports server security (13-oracle_setup_reports.sh):
#   ldap       secured: securityId + JSE identity store = WebLogic embedded LDAP
#              (WebLogic users/roles RW_MONITOR, RW_EXECREPORTS); needs
#              embedded_ldap_sec.conf.des3 (cn=Admin password, manual step)
#   identifier not secured: getserverinfo only for <identifier>, no user check
REPORTS_SECURITY=ldap
# Broadcasting port – unique per environment in the subnet (range: 14021–14030)
# 14027 = FMW 14.1.2.0.0 production,  14028 = standby  (Doc ID 437228.1)
REPORTS_BROADCAST_PORT=14027
# rwserver.conf engine tuning
REPORTS_ENGINE_INIT=2
REPORTS_ENGINE_MAX=5
REPORTS_ENGINE_MIN=2
REPORTS_ENGINE_LIFE=50
# maxIdle (minutes) / engine jvmOptions (e.g. "-Xmx1g"): empty = Oracle default
REPORTS_ENGINE_MAX_IDLE=
REPORTS_ENGINE_JVM_OPTIONS=
REPORTS_MAX_CONNECT=300
REPORTS_MAX_QUEUE=4000
# rwservlet.properties cookie encryption key – generate once, keep stable
REPORTS_COOKIE_KEY=

# --- Backup retention (07-Maintenance/README.md) ---
# backup_config.sh --apply keeps the newest N sets in ConfigBackup/,
# bak_cleanup.sh --apply the newest N *.bak_<ts> copies per file
CONFIG_BACKUP_KEEP=10
BAK_FILES_KEEP=3
