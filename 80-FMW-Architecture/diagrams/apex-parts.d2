direction: down

classes: {
  ext: {
    style: {
      fill: "#EDEDED"
      stroke: "#7F7F7F"
      border-radius: 8
      stroke-width: 1
      shadow: false
      3d: false
      font-size: 20
      font-color: "#C00000"
    }
  }
  mw_zone: {
    grid-columns: 1
    grid-gap: 16
    style: {
      fill: "#FFFFFF"
      stroke: "#548235"
      stroke-dash: 4
      border-radius: 8
      stroke-width: 1
      shadow: false
      3d: false
      font-size: 22
      bold: true
      font-color: "#C00000"
    }
  }
  mw_part: {
    style: {
      fill: "#E2EFDA"
      stroke: "#548235"
      border-radius: 8
      stroke-width: 1
      shadow: false
      3d: false
      font-size: 20
      font-color: "#262626"
    }
  }
  mw_main: {
    style: {
      fill: "#A9D18E"
      stroke: "#548235"
      border-radius: 8
      stroke-width: 1
      shadow: false
      3d: false
      font-size: 20
      font-color: "#C00000"
    }
  }
  db_zone: {
    grid-columns: 1
    grid-gap: 16
    style: {
      fill: "#FFFFFF"
      stroke: "#2E75B6"
      stroke-dash: 4
      border-radius: 8
      stroke-width: 1
      shadow: false
      3d: false
      font-size: 22
      bold: true
      font-color: "#C00000"
    }
  }
  db_part: {
    style: {
      fill: "#DEEBF7"
      stroke: "#2E75B6"
      border-radius: 8
      stroke-width: 1
      shadow: false
      3d: false
      font-size: 20
      font-color: "#C00000"
    }
  }
  conn: {
    style: {
      stroke: "#7F7F7F"
      stroke-width: 2
      font-color: "#000000"
      font-size: 18
    }
  }
}

browser: "browser" {class: ext}
script: "script / other system" {class: ext}

nginx: "Nginx (TLS, one host name)" {
  class: mw_zone
  images: "/i/  -> alias /srv/apex/apex_1/\n(static images, no ORDS)" {class: mw_part}
  ords_route: "/ords/ -> 127.0.0.1:8081\nX-Forwarded-For = \$remote_addr (overwritten)" {class: mw_part}
}

ords: "ORDS 26.x standalone (Jetty 12, java at JDK_HOME)" {
  class: mw_zone
  config: "config dir  ords_1/config/\ndatabases/<pool>/pool.xml + wallet,\nglobal/settings.xml, credentials, logging" {class: mw_part}
  pool: "JDBC pool (UCP) - connects as\nORDS_PUBLIC_USER (runtime user)" {class: mw_main}
}

db: "database (PDB)" {
  class: db_zone
  apex_public: "APEX_PUBLIC_USER -> APEX engine\n(schema APEX_260200, FLOWS_FILES):\nwwv_flow.show/accept, the app's PL/SQL,\nsession state" {class: db_part}
  rest_schema: "<SCHEMA> (REST-enabled) -> handler PL/SQL /\nSQL of the REST module" {class: db_part}
  ords_metadata: "ORDS_METADATA  - REST\nmodules/templates/handlers, privileges,\nroles, OAuth clients, schema aliases\n(the \"ORDS repository\")" {class: db_part}
}

browser -> nginx: "HTTPS  /ords/r/<app>/..." {class: conn}
script -> nginx: "HTTPS  /ords/<schema>/<module>/..." {class: conn}
nginx -> ords: "" {class: conn}
ords -> db: "proxy: ORDS_PUBLIC_USER[APEX_PUBLIC_USER]" {class: conn}
ords -> db: "proxy: ORDS_PUBLIC_USER[<SCHEMA>]" {class: conn}
