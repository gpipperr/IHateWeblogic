direction: down

classes: {
  ext: {
    width: 280
    style: {
      fill: "#EDEDED"
      stroke: "#7F7F7F"
      border-radius: 8
      stroke-width: 1
      shadow: false
      3d: false
      font-size: 20
      font-color: "#C00000"
    }
  }
  mw_line: {
    style: {
      fill: "#E2EFDA"
      stroke: "#548235"
      border-radius: 8
      stroke-width: 1
      shadow: false
      3d: false
      font-size: 20
      font-color: "#262626"
    }
  }
  db_line: {
    shape: rectangle
    style: {
      fill: "#DEEBF7"
      stroke: "#2E75B6"
      border-radius: 8
      stroke-width: 1
      shadow: false
      3d: false
      font-size: 20
      font-color: "#262626"
    }
  }
  mw_box: {
    grid-columns: 1
    grid-gap: 16
    style: {
      fill: "#FFFFFF"
      stroke: "#548235"
      stroke-dash: 4
      border-radius: 8
      stroke-width: 1
      shadow: false
      3d: false
      font-size: 22
      bold: true
      font-color: "#C00000"
    }
  }
  db_box: {
    grid-columns: 1
    grid-gap: 16
    style: {
      fill: "#FFFFFF"
      stroke: "#2E75B6"
      stroke-dash: 4
      border-radius: 8
      stroke-width: 1
      shadow: false
      3d: false
      font-size: 22
      bold: true
      font-color: "#C00000"
    }
  }
  conn: {
    style: {
      stroke: "#7F7F7F"
      stroke-width: 2
      font-color: "#000000"
      font-size: 18
    }
  }
}

browser: "browser" {class: ext}
script: "script / other system" {class: ext}

nginx: "Nginx (TLS, one host name)" {
  class: mw_box
  n1: "/i/  -> alias /srv/apex/apex_1/\n(static images, no ORDS)" {class: mw_line}
  n2: "/ords/ -> 127.0.0.1:8081\nX-Forwarded-For = \$remote_addr\n(overwritten)" {class: mw_line}
}

ords: "ORDS 26.x standalone\n(Jetty 12, java at JDK_HOME)" {
  class: mw_box
  o1: "config dir  ords_1/config/\ndatabases/<pool>/pool.xml + wallet,\nglobal/settings.xml, credentials, logging" {class: mw_line}
  o2: "JDBC pool (UCP) - connects as\nORDS_PUBLIC_USER (runtime user)" {class: mw_line}
}

db: "database (PDB)" {
  class: db_box
  d1: "APEX_PUBLIC_USER -> APEX engine\n(schema APEX_260200, FLOWS_FILES):\nwwv_flow.show/accept, the app's PL/SQL,\nsession state" {class: db_line}
  d2: "<SCHEMA> (REST-enabled) -> handler PL/SQL /\nSQL of the REST module" {class: db_line}
  d3: "ORDS_METADATA  -\nREST modules/templates/handlers, privileges,\nroles, OAuth clients, schema aliases\n(the \"ORDS repository\")" {class: db_line}
}

browser -> nginx: "HTTPS\n/ords/r/<app>/..." {class: conn}
script -> nginx: "HTTPS\n/ords/<schema>/\n<module>/..." {class: conn}
nginx -> ords {class: conn}
ords -> db: "proxy:\nORDS_PUBLIC_USER\n[APEX_PUBLIC_USER]" {class: conn}
ords -> db: "proxy:\nORDS_PUBLIC_USER\n[<SCHEMA>]" {class: conn}
