direction: down

client: "Forms client (Java, FSAL / Web Start)" {
  style.fill: "#EDEDED"
  style.stroke: "#7F7F7F"
  style.border-radius: 8
  style.stroke-width: 1
  style.shadow: false
  style.font-size: 20
  style.font-color: "#C00000"
}

nginx: "Nginx :443\n← access.log: rt / urt / uct" {
  style.fill: "#E2EFDA"
  style.stroke: "#548235"
  style.border-radius: 8
  style.stroke-width: 1
  style.shadow: false
  style.font-size: 20
  style.font-color: "#C00000"
}

wls: "WLS_FORMS  /forms/lservlet\n← access.log: time-taken" {
  style.fill: "#A9D18E"
  style.stroke: "#548235"
  style.border-radius: 8
  style.stroke-width: 1
  style.shadow: false
  style.font-size: 20
  style.font-color: "#C00000"
}

frmweb: "frmweb  (one process per session)\n← CPU, RSS (forms_perf_analyse.sh)" {
  style.fill: "#E2EFDA"
  style.stroke: "#548235"
  style.border-radius: 8
  style.stroke-width: 1
  style.shadow: false
  style.font-size: 20
  style.font-color: "#C00000"
}

db: "Database\n← SQL / PL/SQL of the form (open, §5)" {
  shape: cylinder
  style.fill: "#DEEBF7"
  style.stroke: "#2E75B6"
  style.stroke-width: 1
  style.shadow: false
  style.font-size: 20
  style.font-color: "#C00000"
}

client -> nginx: "HTTPS\n← network, TLS" {
  style.stroke: "#7F7F7F"
  style.stroke-width: 2
  style.font-color: "#000000"
  style.font-size: 18
}

nginx -> wls: "HTTP 127.0.0.1,\nkeepalive" {
  style.stroke: "#7F7F7F"
  style.stroke-width: 2
  style.font-color: "#000000"
  style.font-size: 18
}

wls -> frmweb: "local socket" {
  style.stroke: "#7F7F7F"
  style.stroke-width: 2
  style.font-color: "#000000"
  style.font-size: 18
}

frmweb -> db: "Oracle Net\n(TNS_ADMIN)" {
  style.stroke: "#7F7F7F"
  style.stroke-width: 2
  style.font-color: "#000000"
  style.font-size: 18
}
