# =============================================================================
# wlsmon - security headers, rendered by 02-install-wlsmon_root.sh to
# /etc/nginx/wlsmon/headers.conf. Included in EVERY wlsmon location (an
# add_header in a location stops the inheritance from above). Not in conf.d:
# there it would apply to the whole http{} block - Forms and APEX stay as
# they are. CSP: no inline code, no eval; same origin covers /i/.
# =============================================================================
add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src ##WLSMON_STYLE_SRC##; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "no-referrer" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
add_header X-Frame-Options "DENY" always;
