# =============================================================================
# wlsmon - request limit zone (http context), rendered by
# 02-install-wlsmon_root.sh to /etc/nginx/conf.d/wlsmon_zone.conf.
# Used by the wlsmon locations (limit_req zone=wlsmon burst=20 nodelay).
# =============================================================================
limit_req_zone $binary_remote_addr zone=wlsmon:1m rate=10r/s;
