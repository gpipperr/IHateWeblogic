# =============================================================================
# Nginx locations of one ORDS instance – rendered by 12-APEX-Ords/05-setup-nginx.sh
# to /etc/nginx/oracle-wls.d/ords_N.conf, included INSIDE the 443 server block of
# /etc/nginx/conf.d/oracle-wls.conf (09-Install/nginx-wls.conf.template).
#   ##CONTEXT##  ORDS_N_CONTEXT (/ords)      ##PORT##      ORDS_N_PORT (8081)
#   ##PREFIX##   ORDS_N_IMAGE_PREFIX (/i/)   ##IMAGE_DIR## APEX_WEB_DIR/apex_N
#   ##INST##     ords_N
# Remove the instance = delete this file + nginx -t + reload.
# =============================================================================

# --- ##INST##: APEX + REST through ORDS (Jetty on 127.0.0.1 only) -------------
location ##CONTEXT##/ {
    proxy_pass         http://127.0.0.1:##PORT####CONTEXT##/;
    proxy_set_header   Host              $host;
    # client IP for APEX / owa_util: OVERWRITE, never append – a client-sent
    # X-Forwarded-For would otherwise reach PL/SQL (12-APEX-Ords/README.md §5.7)
    proxy_set_header   X-Forwarded-For   $remote_addr;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-Proto https;
    proxy_set_header   X-Forwarded-Port  443;
    proxy_set_header   X-Forwarded-Host  $host;
    proxy_connect_timeout 60s;
    proxy_read_timeout    300s;
    proxy_send_timeout    300s;
    proxy_buffer_size       128k;
    proxy_buffers           4 256k;
    proxy_busy_buffers_size 256k;
    client_max_body_size    100m;
}

# --- ##INST##: APEX static files – served by Nginx, never by ORDS -------------
location ##PREFIX## {
    alias      ##IMAGE_DIR##/;
    expires    7d;
    access_log off;
}
