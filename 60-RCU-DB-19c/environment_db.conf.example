# =============================================================================
# environment_db.conf  –  Oracle 19c RCU Database configuration
# =============================================================================
# Create with ./60-RCU-DB-19c/00a-db_env_interview.sh --apply (or copy + edit, then --check).
# chmod 600 environment_db.conf
#
# This file is SEPARATE from environment.conf (FMW/WLS).
# Both files share ORACLE_BASE, ORACLE_INVENTORY, PATCH_STORAGE, ROOT_DIR and the lib.
#
# Directory convention (same ORACLE_BASE, separate product subtrees):
#   ORACLE_BASE/fmw/                    ← FMW_HOME  (FMW 14.1.2 software)
#   ORACLE_BASE/product/19.33.0/db_home1← DB patched home (DB_ORACLE_HOME, RU 33)
#   ORACLE_BASE/oradata/FMWCDB/         ← DB data files
#   ORACLE_BASE/flash_recovery_area/    ← Fast Recovery Area (FRA)
#   ORACLE_BASE/admin/FMWCDB/adump/     ← audit dump
#   ORACLE_BASE/diag/rdbms/fmwcdb/...  ← Oracle ADR (automatic)
#
# Bridge to FMW: after the PDB is running, set in environment.conf:
#   DB_HOST=...  DB_PORT=1521  DB_SERVICE=FMWPDB
# =============================================================================

# --- Oracle Base (shared with FMW) ---------------------------------------------
# Default = ORACLE_BASE of environment.conf (read before this file) – a fixed
# value here OVERRIDES it for all 60- scripts; set one only for a DB-only host.
ORACLE_BASE="${ORACLE_BASE:-/u01/app/oracle}"

# --- Oracle Central Inventory (shared by FMW + DB) -----------------------------
# Default = ORACLE_INVENTORY of environment.conf (interview; e.g. /opt/oraInventory
# when ORACLE_BASE is /oracle). /etc/oraInst.loc (03-root_user_oracle.sh) is what
# the DB runInstaller really uses. A fixed /u01/... value here made 01- warn and
# suggest re-pointing oraInst.loc (customer 2026-11-02) – keep the default.
ORACLE_INVENTORY="${ORACLE_INVENTORY:-$(dirname "$ORACLE_BASE")/oraInventory}"

# --- Edition ------------------------------------------------------------------
# EE (Enterprise Edition) is the default and recommended setting.
# SE2 (Standard Edition 2) is sufficient for a pure RCU-only metadata database
# but EE avoids any certification edge cases with FMW components.
# Change to SE2 only when explicitly licensed for SE2 and cost matters.
DB_EDITION="EE"                               # EE | SE2

# CV_ASSUME_DISTID for the 19.3.0 base installer on OL8/OL9.
# 19.3.0 predates OL8 — supportedOSCheck throws NPE without this override.
# OEL7.6 is the correct value; 01-db_install_software.sh exports it on every
# route (19.3 image, patched image, gold image installer).
# MOS Doc ID 2584365.1 / https://www.robotron.de/unternehmen/aktuelles/blog/oracle-datenbank-19c-und-oracle-linux-8
DB_CV_ASSUME_DISTID="OEL7.6"

# --- Oracle Homes -------------------------------------------------------------
# Patched home: gold image, else 19.3 base + opatch RU, then runInstaller (01-db_install_software.sh)
# Current RU: 19.33 (Oct 2026) — the directory names the RU; a newer RU = new home (09-db_patch_rcu.sh).
DB_ORACLE_HOME="${ORACLE_BASE}/product/19.33.0/db_home1"

# --- Storage (all under ORACLE_BASE for clean separation from FMW) -----------
DB_DATA_DIR="${ORACLE_BASE}/oradata"          # datafiles:  ORACLE_BASE/oradata/FMWCDB/
DB_ADMIN_DIR="${ORACLE_BASE}/admin"           # audit dump: ORACLE_BASE/admin/FMWCDB/adump/
# Oracle ADR (diag/rdbms/...) is placed automatically under ORACLE_BASE
# when DIAGNOSTIC_DEST is left at its default (= ORACLE_BASE).
# No explicit variable needed — set automatically by Oracle.

DB_FAST_RECOVERY_AREA="${ORACLE_BASE}/flash_recovery_area"  # FRA: logs, backups, flashback
DB_RECOVERY_SIZE_MB=10960                      # db_recovery_file_dest_size (~10.7 GB; 03- default without this line: 4096)

# --- Database Identity -------------------------------------------------------
DB_SID="FMWCDB"
DB_CDB_NAME="FMWCDB"
DB_PDB_NAME="FMWPDB"

# --- Memory ------------------------------------------------------------------
# SGA_TARGET + PGA_AGGREGATE_TARGET (works with and without HugePages).
# Do NOT use MEMORY_TARGET (AMM) when HugePages are active.
#
# Minimum for stable RCU PL/SQL compilation:
#   SGA: 1536 MB   PGA: 512 MB   Total: ~2 GB
DB_SGA_MB=1536
DB_PGA_MB=512

# --- Processes / Cursors / Files ---------------------------------------------
# Minimums of the FMW 14.1.2 System Requirements ("RCU Requirements for Oracle
# Databases") – 80-FMW-Architecture/rcu_middleware_architecture.md 9.2.
# processes / session_cached_cursors / db_files are static (restart).
DB_PROCESSES=1000
DB_OPEN_CURSORS=1600
DB_SESSION_CACHED_CURSORS=100
DB_FILES=600

# --- Listener ----------------------------------------------------------------
DB_LISTENER_HOST=""          # hostname/IP for listener.ora; empty = auto-detect (hostname -f)
DB_LISTENER_PORT=1521

# --- Character Set -----------------------------------------------------------
# AL32UTF8 is required by FMW — do not change.
DB_CHAR_SET="AL32UTF8"
DB_NCHAR_SET="AL16UTF16"

# --- Archivelog --------------------------------------------------------------
# false for dev/test (saves disk — metadata-only DB needs no point-in-time recovery)
# true  for production (set DB_FAST_RECOVERY_AREA as well)
DB_ARCHIVELOG=false

# --- Audit Tablespace (04-db_audit_setup.sh) ---------------------------------
DB_AUDIT_TS_SIZE_MB=100            # initial size; purge job keeps it bounded
DB_AUDIT_TS_MAX_MB=4000            # max 4 GB
DB_AUDIT_RETAIN_DAYS=180           # purge records older than N days

# --- Optional: FMW_DATA Tablespace (05-db_fmw_tablespace.sh) -----------------
# Leave empty to let RCU create its own tablespaces (recommended for dev).
# Set to enable pre-created tablespace (enterprise/production).
# Must match RCU_TABLESPACE in environment.conf.
DB_FMW_TABLESPACE=""               # e.g. FMW_DATA
DB_FMW_TABLESPACE_SIZE_MB=500      # initial size

# --- AutoUpgrade / Patching (01-db_install_software.sh) ----------------------
DB_AUTOUPGRADE_HOME="${ORACLE_BASE}/autoupgrade"
DB_TARGET_RU="RECOMMENDED"         # RECOMMENDED = recommended,jdk (gold image + OJVM + DPBP + JDK + OPatch)
                                   # or fixed: 19.33  (ru/ojvm 19.33 + opatch,dpbp,jdk – reproducible)
MOS_SEC_FILE="${ROOT_DIR}/mos_sec.conf.des3"   # shared with 09-Install

# --- Install Archive (01-db_install_software.sh) -----------------------------
# PATCH_STORAGE comes from environment.conf (/srv/patch_storage).
# Place the 19c base ZIP at: $PATCH_STORAGE/database/LINUX.X64_193000_db_home.zip
DB_INSTALL_ARCHIVE="${PATCH_STORAGE}/database/LINUX.X64_193000_db_home.zip"

# --- Disk space checks (01-db_install_software.sh, checked first) --------------
# new home min / recommended, AutoUpgrade staging (base_stage + patch ZIPs + patch_stage)
DB_HOME_MIN_FREE_GB=12   # 19.33 gold image unpacked + OneOffs = 11 GB (2026-10-28)
DB_HOME_REC_FREE_GB=15
DB_STAGE_MIN_FREE_GB=8
DB_STAGE_REC_FREE_GB=14
# DB_ORACLE_HOME_PREV is written by 09-db_patch_rcu.sh (previous home, --rollback)

# --- Standalone CVU (00b-db_cvu_check.sh) -------------------------------------
# MOS patch DB_CVU_PATCH_NR (09-Install/oracle_software_version.conf), downloaded
# by 09-Install/04-oracle_pre_download.sh --apply --mos when LOCAL_REP_DB=true
DB_CVU_DIR="${PATCH_STORAGE}/database/cvu"
DB_CVU_HOME="${ORACLE_BASE}/cvu"           # CV home, >= 500 MB
